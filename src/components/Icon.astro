---
// Line icons drawn for this site; colour comes from currentColor (tokens).
type Name = "phone" | "telegram" | "whatsapp" | "viber" | "mail" | "pin" | "arrow" | "external" | "menu" | "close" | "chat";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 5.2 5.2l1.4-2.1 4.2 1.6V17a3 3 0 0 1-3.2 3A15.5 15.5 0 0 1 2 6.7 3 3 0 0 1 5 3.5Z" />}
  {name === "telegram" && <><path d="M21 4 3 11.2l5.6 2.1L18 7l-7.2 7.6.3 5.4 3-3.6 4.4 3.1Z" /></>}
  {name === "whatsapp" && <><path d="M4.2 19.8 5.3 16a8.3 8.3 0 1 1 3 2.9Z" /><path d="M9.2 8.6c.2-.5.5-.6.8-.6h.5l.9 2-.6.9a5 5 0 0 0 2.5 2.4l.9-.6 2 .9v.5c0 .5-.4 1.2-1.4 1.3-2.6.2-6.4-3.4-5.6-6.8Z" /></>}
  {name === "viber" && <><path d="M12 2.8c4.8 0 8 1.6 8 7.4 0 5.4-3 7-7.4 7l-3.4 3.2V17C5.6 16.4 4 14.6 4 10.2 4 4.4 7.2 2.8 12 2.8Z" /><path d="M9.4 7.4h.6l.9 1.9-.6.8a4 4 0 0 0 2 2l.8-.6 1.9.9v.6c0 .5-.5 1-1.2 1-2.3 0-4.6-2.3-4.6-4.6 0-.7.5-2 .2-2Z" /></>}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === "pin" && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === "arrow" && <path d="M4 12h15m-5-5 5 5-5 5" />}
  {name === "external" && <path d="M8 16 17 7m-7 0h7v7" />}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
  {name === "chat" && <path d="M4.5 5h15v10.5H10L5.5 19v-3.5h-1Z" />}
</svg>
