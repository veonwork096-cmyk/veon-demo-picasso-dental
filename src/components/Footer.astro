---
import Logo from "./Logo.astro";
import FutureLink from "./FutureLink.astro";
import { clinic } from "../data/clinic";
---
<footer class="footer field-stone">
  <div class="container footer__grid">
    <a class="footer__logo" href="#hero" aria-label="Picasso Dental Clinic — на початок сторінки"><Logo /></a>
    <div class="footer__legal">
      <p>{clinic.legal}</p>
      <p>{clinic.license}</p>
      <p>{clinic.street}, {clinic.building}, {clinic.city}</p>
    </div>
    <ul class="footer__contacts">
      <li><a class="link num" href={clinic.phoneMain.href}>{clinic.phoneMain.label}</a></li>
      <li><a class="link num" href={clinic.phoneSecond.href}>{clinic.phoneSecond.label}</a></li>
      <li><a class="link" href={`mailto:${clinic.email}`}>{clinic.email}</a></li>
    </ul>
    <ul class="footer__pages" aria-label="Сторінки повної версії сайту">
      <li><FutureLink>Про клініку</FutureLink></li>
      <li><FutureLink>Блог</FutureLink></li>
      <li><FutureLink>Політика конфіденційності</FutureLink></li>
    </ul>
    <p class="footer__copy small">© 2026 Picasso Dental Clinic, Ужгород</p>
  </div>
</footer>

<style>
  .footer { padding-block: var(--s5) var(--s4); border-top: 1px solid var(--hair-on-stone); font-size: var(--fs-small); color: var(--muted-on-stone); }
  .footer__grid { display: grid; gap: var(--s4); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 768px) { .footer__grid { grid-template-columns: auto repeat(3, minmax(0, 1fr)); column-gap: var(--s5); } }
  .footer__logo { color: var(--porcelain); display: block; width: 72px; }
  .footer__legal { display: grid; gap: .25rem; }
  .footer__contacts, .footer__pages { display: grid; gap: .5rem; align-content: start; }
  .footer__contacts .link { color: var(--porcelain); }
  .footer__copy { grid-column: 1 / -1; padding-top: var(--s3); border-top: 1px solid var(--hair-on-stone); }
</style>
